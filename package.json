{
  "name": "wb-rs-ht",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build-db": "bash scripts/build-db.sh",
    "build-icons": "magick -background none static/icon-512.svg -resize 180x180 static/apple-touch-icon.png && magick -background none static/icon-512.svg -resize 192x192 static/icon-192.png && magick -background none static/icon-512.svg -resize 512x512 static/icon-512.png",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@sqlite.org/sqlite-wasm": "^3.50.0-build1",
    "@tanstack/svelte-virtual": "^3.13.24",
    "@xyflow/svelte": "^1.5.2",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "lucide-svelte": "^1.0.1",
    "mode-watcher": "^1.1.0",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260511.1",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.5",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/node": "^25.7.0",
    "@vite-pwa/sveltekit": "^1.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "@playwright/test": "^1.60.0",
    "playwright": "^1.60.0",
    "postcss": "^8.4.49",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "svelte-eslint-parser": "^1.6.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.3",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  }
}
